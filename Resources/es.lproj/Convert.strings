/* The Conversions built-in's results. Keys are the English text; what people type stays English. */

/* Rows */
"Type a conversion" = "Escribe una conversión";
"Like 10 km in mi, 72f in c, time in tokyo, 3pm london in nyc or days until dec 25" = "Por ejemplo: 10 km in mi, 72f in c, time in tokyo, 3pm london in nyc o days until dec 25";
"No result" = "Ningún resultado";
"Copy Answer" = "Copiar resultado";
"Paste Answer" = "Pegar resultado";

/* Clocks. “Here” is the user's own time zone. */
"Here" = "Aquí";
